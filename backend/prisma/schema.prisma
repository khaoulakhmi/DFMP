// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
  

model User {
  id        String   @id @default(cuid())
  name      String 
  username  String @unique
  password  String
  role      Role
  status    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  authSessions AuthSession[]
}

model Provider {
  id        String   @id @default(cuid())
  name      String 
  company   String
  email     String @unique
  phone     String
  bankAccountNumber String 
  bankName  String
  NIF       String
  NIS       String
  address   String
  commercialRegisterNumber String
  markets                 Market[]
  invoices                Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String?   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  tokenHash String?      @unique
  usedAt    DateTime?
  sessionId String?
  session   AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

model Designation {
  id          Int      @id @default(autoincrement())
  name        String   
  description String?  
  products    Product[]
  lots        Lot[]
  specifications Specifications[]
}

model Residence {
  id              Int      @id @default(autoincrement())
  name            String   // Nom Residence [1, 2]
  address         String
  numberOfUnits   Int      // Nbre Résidence [1, 2]
  restaurants     Restaurant[]
}

model Restaurant {
  id          Int       @id @default(autoincrement())
  name        String    
  residenceId Int   
  residence   Residence @relation(fields: [residenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([residenceId])
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String 
  unit            String   
  unitPrice       Decimal  @db.Decimal(20, 2)
  evaluationPrice Decimal? @db.Decimal(20, 2)   
  tva             TVA
  providerPrice   Decimal? @db.Decimal(20, 2) 
  quantityMin     Int      
  quantityMax     Int      
  designationId   Int
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Restrict, onUpdate: Cascade)     
  lotId           Int?
  lot             Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([designationId])
  @@index([lotId])
}

model Lot {
  id              Int               @id @default(autoincrement())
  name            String            
  designationId       Int
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Restrict, onUpdate: Cascade)  
  products        Product[]
  markets         Market[]
  specifications  Specifications?   @relation(fields: [specificationsId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  specificationsId Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([designationId])
  @@index([specificationsId])
}

model Specifications {
  id                  Int       @id @default(autoincrement()) // Cahier de Charge [1, 3]
  type                String
  designationId       Int
  designation         Designation      @relation(fields: [designationId], references: [id], onDelete: Restrict, onUpdate: Cascade)     
  minAmount           Decimal    @db.Decimal(20, 2) // Montant Min [3]
  maxAmount           Decimal     @db.Decimal(20, 2) // Montant Max [3]
  year                Int       // Année [3]
  
  // Internal Timeline
  depositDateCM       DateTime? // Date du Depot C.M. [3]
  sessionDate         DateTime? // Date du Séance [3]
  visaDate            DateTime? // Date Visa [3]
  visaNumber          String?   // N° Visa [3]

  // Publicity Tracking [3]
  pubArabicDate       DateTime?
  pubArabicJournal    String?
  pubFrenchDate       DateTime?
  pubFrenchJournal    String?
  pubArElecJournal    String?
  pubFrElecJournal    String?

  lots                Lot[]
  tendering           Tendering?

  @@index([designationId])
}

model Tendering {
  id                  Int            @id @default(autoincrement())
  specificationsId    Int            @unique
  specifications      Specifications @relation(fields: [specificationsId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  
  // Evaluation Phase [3]
  openingDate         DateTime?      // Date l'ouverture
  techEvalDate        DateTime?      // Date evaluation technique
  finEvalDate         DateTime?      // Date evaluation financière
  
  // Attribution [3]
  attributionDate     DateTime?      // Date attribution
  delayPeriodDays     Int            @default(10) // Délai 10 jours
  
  // Appeals (Recours) [3]
  appealDate          DateTime?
  appealDepositDate   DateTime?
  appealResult        String?        // Nom (Retour) OK
  programmingDate     DateTime?      // Date programmation
  avsStatus           AVSStatus?     // A.V.S. Fondu / Non fondu
}

model Market {
  id              Int       @id @default(autoincrement()) // Marché [1, 2]
  marketNumber    String    @unique // N° du Marché
  providerId      String
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lotId           Int
  lot             Lot       @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  date            DateTime
  
  // Administrative Visas [1, 2]
  depositDate     DateTime?
  visaNumberCM    String?   // N° visa C.M.
  visaDateCM      DateTime? // Date visa C.M.
  visaNumberCF    String?   // N° visa C.F. (Contrôle Financier)
  visaDateCF      DateTime? // Date visa C.F.

  invoices        Invoice[]
  status          DealStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([providerId])
  @@index([lotId])
}

model Invoice {
  id              Int      @id @default(autoincrement()) // Facture [1, 2]
  invoiceNumber   String   @unique // N° Facture
  providerId      String
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  marketId        Int
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  amount          Decimal  @db.Decimal(20, 2)  // Montant
  quantity        Int      // Qtite
  createdAt       DateTime @default(now())

@@index([providerId])
@@index([marketId])
}

enum Role {
    ADMIN
    SALES
    FINANCE
    ACCOUNTANT
}

enum TVA {
    ZERO
    NINE
    NINETEEN
}

enum DealStatus {
    PENDING
    APPROVED
    REJECTED
}

enum AVSStatus {
    FONDU
    NON_FONDU
}

